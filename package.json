{
  "name": "@brello/sdk",
  "version": "0.0.1",
  "description": "Brello usage tracking for OpenAI and Anthropic TypeScript clients.",
  "license": "MIT",
  "author": "Dan <gyeon@brello.app>",
  "contributors": [
    {
      "name": "Brello",
      "email": "hello@brello.app"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "brello",
    "sdk",
    "typescript",
    "openai",
    "anthropic"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "tsdown"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "tsdown": "^0.23.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.0"
  }
}
